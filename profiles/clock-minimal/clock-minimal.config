# Clock diet for bullhead: merged on top of lineageos_bullhead_defconfig
# (the defconfig embedded-compose's nexus5x board builds), the same way
# nexus5x-hike-buddy merges config/hike-buddy.config onto bullhead_defconfig.
#
# Brief: "I only want to use the phone as a clock." So the rule is harsher
# than Hike Buddy's: keep ONLY what a clock needs — display + backlight,
# touch + keys (to set the time), the RTC, the charger/fuel gauge (it still
# has to charge), USB gadget (dev link + charging). Everything else goes,
# including the modem — a clock needs no GPS, and GPS lives in the modem,
# so the modem never even boots.
#
# Merge with: scripts/kconfig/merge_config.sh -m .config clock-minimal.config
# merge_config reports any symbol the tree doesn't know; treat those as
# review items, not errors (some names differ between the 3.10 Android
# kernel and mainline — e.g. the 6.12 port has no KGSL or QCA_CLD at all).

# --- what stays (made explicit so a defconfig change can't drop it quietly)
CONFIG_FB_MSM_MDSS=y
CONFIG_LEDS_QPNP_WLED=y
CONFIG_RTC_DRV_QPNP=y
CONFIG_QPNP_POWER_ON=y
CONFIG_INPUT_GPIO_KEYS=y
CONFIG_TOUCHSCREEN_SYNAPTICS_I2C_RMI4=y
CONFIG_QPNP_SMBCHARGER=y
CONFIG_QPNP_FG=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_USB_GADGET=y

# --- no Android userspace (same as hike-buddy.config)
# CONFIG_ANDROID_BINDER_IPC is not set
# CONFIG_ASHMEM is not set
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SDCARD_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_EXT4_FS_ENCRYPTION is not set
# CONFIG_QUOTA is not set

# --- radios: all of them. Wi-Fi, Bluetooth, NFC — and the modem itself,
#     which is where GPS lives on this phone (QMI LOC over the IPC router,
#     Hike Buddy's whole GPS path). No modem => no PIL load, no rmt_storage,
#     several seconds and a hot chip saved at every boot.
# CONFIG_CFG80211 is not set
# CONFIG_QCA_CLD_WLAN is not set
# CONFIG_WLAN is not set
# CONFIG_CNSS is not set
# CONFIG_WCNSS_MEM_PRE_ALLOC is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_MSM_PIL is not set
# CONFIG_PIL_MSS_QDSP6V2 is not set
# CONFIG_MSM_IPC_ROUTER_SMD_XPRT is not set
# CONFIG_QCOM_SMD is not set
# CONFIG_RMNET_DATA is not set
# CONFIG_IPA is not set

# --- camera, video, GPU, audio: a clock is silent and still
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_MSMB_CAMERA is not set
# CONFIG_MSM_VIDC_V4L2 is not set
# CONFIG_MSM_KGSL is not set
# CONFIG_SND_SOC is not set
# CONFIG_SND_USB_AUDIO is not set
# AV timer is ADSP audio plumbing: avtimer.c calls q6core_is_adsp_ready(),
# which lives in the (disabled) QDSP6 core — leaving AVTIMER on breaks the
# vmlinux link with an undefined reference (found 3 Nov build).
# CONFIG_MSM_AVTIMER is not set
# CONFIG_WCD9330_CODEC is not set
# CONFIG_SLIMBUS_MSM_NGD is not set
# CONFIG_MSM_ADSPRPC is not set
# CONFIG_MSM_ADSP_LOADER is not set
# CONFIG_MSM_QDSP6V2_CODECS is not set
# CONFIG_FB_MSM_MDSS_WRITEBACK is not set
# CONFIG_LEDS_QPNP_FLASH is not set

# --- sensors: no nanohub, no sensor hub clients. The clock does not step,
#     point north or know which way is up.
# CONFIG_SENSORS_SSC is not set
# CONFIG_STMVL6180 is not set
# CONFIG_INPUT_FPC1020 is not set
# CONFIG_QSEECOM is not set

# --- networking beyond the optional USB dev link
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_PPP is not set

# --- host-side USB and HID zoo (the gadget side stays, for charge + dev)
# CONFIG_UHID is not set
# CONFIG_USB_HIDDEV is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_VIDEO_CLASS is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set

# --- CPU: idle as the default state. powersave governor from boot (the
#     runtime half — capping frequencies and parking the A57 cluster —
#     is power-min.sh, because config alone can't park cores).
CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_INTERACTIVE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND is not set
CONFIG_HZ_100=y

# --- runtime debug/trace overhead (same as hike-buddy.config)
# CONFIG_MSM_RTB is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_TIMER_STATS is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_SLUB_DEBUG is not set

# --- OPTIONAL, off by default (uncomment to try): the boot image runs
#     entirely from its ramdisk, so after the bootloader hands over, the
#     eMMC is never read. Dropping MMC is the last big subsystem — but if
#     anything in your tree probes it during PMIC setup, this is the line
#     that will bite. Try it in QEMU (boards/nexus5x-qemu) first.
# # CONFIG_MMC is not set
